<Window x:Class="FusionPortalClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FusionPortal Client"
        Width="520" Height="480"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding MatchTitleDisplay}"
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />

        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Foreground="Gray" Margin="0,0,0,10" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Refresh" Width="90" Command="{Binding RefreshCommand}" />
        </StackPanel>

        <ListView Grid.Row="3" ItemsSource="{Binding Roster}" SelectedItem="{Binding SelectedPlayer}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Player" DisplayMemberBinding="{Binding DisplayName}" Width="180" />
                    <GridViewColumn Header="Team" DisplayMemberBinding="{Binding Team}" Width="100" />
                    <GridViewColumn Header="Role" DisplayMemberBinding="{Binding Role}" Width="100" />
                    <GridViewColumn Header="Checked In" DisplayMemberBinding="{Binding CheckedIn}" Width="90" />
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Check In" Width="120" Command="{Binding CheckInCommand}" />
        </StackPanel>
    </Grid>
</Window>
